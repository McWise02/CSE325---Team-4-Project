@inherits LayoutComponentBase
@inject NavigationManager Navigation



<div class="page">
    
    @if (!_hide)
    {
        <NavMenu />
    }
    
    <div class="content-container">
        <main class="content">
            @Body
        </main>
        
        @if (!_hide)
        {
            <footer class="footer">
                <p>&copy; @DateTime.Now.Year - Recipe & Meal Tracker</p>
            </footer>
        }
    </div>

</div>

@code
{
    private bool _hide;
    
    protected override void OnInitialized()
    {
        string currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);

        _hide = currentUri.StartsWith("login") || currentUri.StartsWith("register");
    }
}
