@inherits LayoutComponentBase
@inject NavigationManager Navigation


<div class="page">
    
    @if (!_hideNav)
    {
        <NavMenu />
    }
    
    <div class="content-container">
        <main class="content">
            @Body
        </main>

        <footer class="footer">
            <p>&copy; @DateTime.Now.Year - Recipe & Meal Tracker</p>
        </footer>
    </div>

</div>

@code
{
    private bool _hideNav;
    
    protected override void OnInitialized()
    {
        string currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);

        _hideNav = currentUri.StartsWith("login");
    }
}
