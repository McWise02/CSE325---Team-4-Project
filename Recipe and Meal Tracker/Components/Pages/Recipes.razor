@page "/recipes"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using RecipeAndMealTracker.Data
@using RecipeAndMealTracker.Models
@attribute [Authorize]
@inject AppDbContext DbContext
@inject NavigationManager Nav

<div class="recipes-page">
    <div class="recipes-header">
        <h3>Recipes</h3>
        <a class="rp-add-btn" href="/recipes/create">
            <span class="create-recipe-icon"></span>
            Add Recipe
        </a>
    </div>

    <div class="rp-toolbar">
        <input class="rp-search" type="text" placeholder="Search recipes..." @bind="SearchTerm" @bind:event="oninput" />

        <select class="rp-filter" @bind="IngredientFilter">
            <option value="">Filt. by Ingredient</option>
            @foreach (var ing in AllIngredientNames)
            {
                <option value="@ing">@ing</option>
            }
        </select>

        <select class="rp-filter" @bind="IngredientCountFilter">
            <option value="">Filt. by Ingr. #</option>
            <option value="1-3">1-3 ingredients</option>
            <option value="4-6">4-6 ingredients</option>
            <option value="7+">7+ ingredients</option>
        </select>
    </div>

    @if (_recipes is null)
    {
        <p>Loading recipes...</p>
    }
    else if (!FilteredRecipes.Any())
    {
        <p class="rp-empty">No recipes match your search/filters.</p>
    }
    else
    {
        <div class="rp-grid">
            @foreach (var recipe in FilteredRecipes)
            {
                <div class="rp-card" @onclick='() => Nav.NavigateTo($"/recipes/{recipe.Id}")'>
                    <div class="rp-card-icon">
                        <span class="recipe-icon"></span>
                    </div>

                    <div class="rp-card-body">
                        <h4 class="rp-card-name">@recipe.Name</h4>
                        <div class="rp-card-meta">
                            <span>@recipe.Ingredients.Count ingredient@(recipe.Ingredients.Count == 1 ? "" : "s")</span>
                            <span class="rp-dot">&middot;</span>
                            <span>Added @recipe.CreatedAtUtc.ToLocalTime().ToString("MMM d")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(recipe.Instructions))
                        {
                            <p class="rp-card-desc">@Truncate(recipe.Instructions, 90)</p>
                        }
                    </div>

                    <div class="rp-card-footer">
                        <a class="rp-edit-btn" href="@($"/recipes/{recipe.Id}/edit")" @onclick:stopPropagation="true">
                            <span class="edit-recipe-icon"></span>
                            Edit
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Recipe>? _recipes;

    private string SearchTerm = "";
    private string IngredientFilter = "";
    private string IngredientCountFilter = "";

    protected override async Task OnInitializedAsync()
    {
        _recipes = await DbContext.Recipes
            .Include(r => r.Ingredients)
            .OrderBy(r => r.Name)
            .ToListAsync();
    }

    private List<string> AllIngredientNames =>
        _recipes is null
            ? new List<string>()
            : _recipes.SelectMany(r => r.Ingredients)
                      .Select(i => i.Name)
                      .Distinct()
                      .OrderBy(n => n)
                      .ToList();

    private IEnumerable<Recipe> FilteredRecipes =>
        (_recipes ?? new List<Recipe>())
            .Where(MatchesSearch)
            .Where(MatchesIngredientFilter)
            .Where(MatchesIngredientCountFilter);

    private bool MatchesSearch(Recipe r) =>
        string.IsNullOrWhiteSpace(SearchTerm) ||
        r.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase);

    private bool MatchesIngredientFilter(Recipe r) =>
        string.IsNullOrEmpty(IngredientFilter) ||
        r.Ingredients.Any(i => i.Name.Equals(IngredientFilter, StringComparison.OrdinalIgnoreCase));

    private bool MatchesIngredientCountFilter(Recipe r) => IngredientCountFilter switch
    {
        "1-3" => r.Ingredients.Count is >= 1 and <= 3,
        "4-6" => r.Ingredients.Count is >= 4 and <= 6,
        "7+" => r.Ingredients.Count >= 7,
        _ => true
    };

    private static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "...";
}