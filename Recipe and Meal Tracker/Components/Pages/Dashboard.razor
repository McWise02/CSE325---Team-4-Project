@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RecipeAndMealTracker.Models
@using RecipeAndMealTracker.Data

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject AppDbContext DbContext

@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">
    
    <div class="welcome-title">
        <h1>Welcome, @DisplayName</h1>
        <p>Here's your meal plan for today.</p>
    </div>
    
    <div class="date-time-box">
        <div class="date-weekday">@CurrentDateTime.ToString("dddd")</div>
        <div class="time">@CurrentDateTime.ToString("HH:mm")</div>
        <div class="date-full">@CurrentDateTime.ToString("dd MMM yyyy")</div>
    </div>

    @if (IsLoading)
    {
        <div class="loading-box">
            Loading today's meals...
        </div>
    }
    else
    {
        <div class="meals-box">

            <section class="meal-section">
                <div class="meal-heading">
                    <h2>Breakfast</h2>
                </div>

                @if (IsLoading)
                {
                    <div class="empty-meal">
                        Loading Breakfast...
                    </div>
                }
                else if (BreakfastMeals.Count == 0)
                {
                    <div class="empty-meal">
                        No breakfast planned.
                    </div>
                    <NavLink class="add-meal-link" href="/planner">
                        Click Here to plan your meals!
                    </NavLink>
                }
                else
                {
                    @foreach (var meal in BreakfastMeals)
                    {
                        <div class="meal-item">
                            <div>
                                <strong>@GetRecipeName(meal)</strong>

                                @if (meal.IsEaten)
                                {
                                    <span class="eaten-badge">Eaten</span>
                                }

                            </div>
                        </div>
                    }
                }
            </section>

            <section class="meal-section">
                <div class="meal-heading">
                    <h2>Lunch</h2>
                </div>

                @if (IsLoading)
                {
                    <div class="empty-meal">
                        Loading Lunch...
                    </div>
                }
                else if (LunchMeals.Count == 0)
                {
                    <div class="empty-meal">
                        No lunch planned.
                    </div>
                    <NavLink class="add-meal-link" href="/planner">
                        Click Here to plan your meals!
                    </NavLink>
                }
                else
                {
                    @foreach (var meal in LunchMeals)
                    {
                        <div class="meal-item">
                            <div>
                                <strong>@GetRecipeName(meal)</strong>

                                @if (meal.IsEaten)
                                {
                                    <span class="eaten-badge">Eaten</span>
                                }
                            </div>
                        </div>
                    }
                }
            </section>

            <section class="meal-section">
                <div class="meal-heading">
                    <h2>Dinner</h2>
                </div>

                @if (IsLoading)
                {
                    <div class="empty-meal">
                        Loading Dinner...
                    </div>
                }
                else if (DinnerMeals.Count == 0)
                {
                    <div class="empty-meal">
                        No dinner planned.
                    </div>
                    <NavLink class="add-meal-link" href="/planner">
                        Click Here to plan your meals!
                    </NavLink>
                }
                else
                {
                    @foreach (var meal in DinnerMeals)
                    {
                        <div class="meal-item">
                            <div>
                                <strong>@GetRecipeName(meal)</strong>

                                @if (meal.IsEaten)
                                {
                                    <span class="eaten-badge">Eaten</span>
                                }
                            </div>
                        </div>
                    }
                }
            </section>

        </div>
    }
    
        <div class="grocery-card">
            <div class="card-icon">📝</div>
            <div>
                <h3>Grocery List for Today</h3>

                @if (GroceryListLoading)
                {
                    <div class="empty-list">
                        Generating grocery list...
                    </div>
                }
                else if (!HasGeneratedList)
                {
                    <div class="empty-list">
                        <h3>Your grocery list is empty</h3>

                        <p>
                            Add a meal to today to have the grocery list populated.
                        </p>
                    </div>
                }
                else if (GroceryItems.Count == 0)
                {
                    <div class="empty-list">
                        <h3>No ingredients found</h3>

                        <p>
                            There are no planned meals for today.
                        </p>
                    </div>
                }
                else
                {
                    <div class="grocery-list">

                        <div class="grocery-table-header">
                            <span>Ingredient</span>
                            <span>Amount</span>
                        </div>

                        @foreach (var item in GroceryItems)
                        {
                            <div class="grocery-row">
                                <span>@item.Name</span>
                                <span>@item.Amount</span>
                            </div>
                        }

                        <button class="grocery-btn" @onclick="CopyGroceryList">
                            <span class="slide-underline-text">Copy Grocery list</span>
                        </button>
                    </div>
                }
            </div>

        </div>

    <div class="action-btns">
        <h3>Quick Actions</h3>

        <a href="/recipes/create" class="action-btn">
            <span class="slide-underline-text">Create Recipe</span>
        </a>
        <a href="/planner" class="action-btn">
            <span class="slide-underline-text">Plan Meal</span>
        </a>
    </div>
        
</div>

@code {
    private string DisplayName { get; set; } = "Friend";

    private bool IsLoading { get; set; } = true;

    private DateTime CurrentDateTime { get; set; } = DateTime.Now;
    private bool HasGeneratedList { get; set; }
    private List<MealEntry> BreakfastMeals { get; set; } = [];
    private List<MealEntry> LunchMeals { get; set; } = [];
    private List<MealEntry> DinnerMeals { get; set; } = [];
    private List<Recipe> SuggestedRecipes { get; set; } = []; 
    private List<GroceryItem> GroceryItems { get; set; } = []; 
    private bool GroceryListLoading { get; set; } = true;
    protected override async Task OnInitializedAsync()
    {
        CurrentDateTime = DateTime.Now;

        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
        {
            IsLoading = false;
            return;
        }

        var user = await UserManager.GetUserAsync(principal);

        if (user is null)
        {
            IsLoading = false;
            return;
        }

        DisplayName = string.IsNullOrWhiteSpace(user.DisplayName)
            ? "Friend"
            : user.DisplayName;

        var today = DateOnly.FromDateTime(DateTime.Today);

        var meals = await DbContext.MealEntries
            .AsNoTracking()
            .Include(x => x.Recipe)
            .Where(x =>
                x.Date == today &&
                x.UserId == user.Id)
            .ToListAsync();

        BreakfastMeals = meals
            .Where(x => x.MealType == MealType.Breakfast)
            .ToList();

        LunchMeals = meals
            .Where(x => x.MealType == MealType.Lunch)
            .ToList();

        DinnerMeals = meals
            .Where(x => x.MealType == MealType.Dinner)
            .ToList();

        IsLoading = false;
        await GenerateList(today);
    }

    private static string GetRecipeName(MealEntry meal)
    {
        return meal.Recipe?.Name ?? $"Recipe #{meal.RecipeId}";
    }

    private async Task GenerateToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        await GenerateList(today);
    }

    private async Task CopyGroceryList()
    {
        if (GroceryItems.Count == 0) return;

        var text = string.Join(Environment.NewLine,
            GroceryItems.Select(x => $"{x.Name} - {x.Amount} {x.Unit}"));
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

        private async Task GenerateList(DateOnly date)
    {
        GroceryListLoading = true;
        HasGeneratedList = true;

        var SelectedDate = DateTime.Today;

        GroceryItems.Clear();

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            GroceryListLoading = false;
            return;
        }

        var meals = await DbContext.MealEntries
            .AsNoTracking()
            .Include(x => x.Recipe)
                .ThenInclude(x => x!.Ingredients)
                    .ThenInclude(x => x.Unit)
            .Where(x =>
                x.UserId == user.Id &&
                x.Date == date)
            .ToListAsync();


        foreach (var meal in meals)
        {
            if (meal.Recipe is null)
            {
                continue;
            }

            foreach (var ingredient in meal.Recipe.Ingredients)
            {
                GroceryItems.Add(new GroceryItem
                {
                    Name = ingredient.Name,

                    Amount = Math.Round(ingredient.Amount ?? 0),

                    Unit = ingredient.Unit?.Name ?? "",

                    Price = ingredient.Price ?? 0,
                    RecipeName = meal.Recipe.Name,
                    MealName = meal.MealType.ToString()
                });
            }
        }

        Console.WriteLine($"GroceryItems count: {GroceryItems.Count}");

        GroceryListLoading = false;
    }

        private class GroceryItem
        {
            public string Name { get; set; } = string.Empty;

            public double Amount { get; set; }

            public string Unit { get; set; } = string.Empty;

            public decimal Price { get; set; }

            public string RecipeName { get; set; } = string.Empty;

            public string MealName { get; set; } = string.Empty;
        }




}
